@charset "utf-8";

@keyframes badge-spin {=20
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.badge-spinner { animation: 1s linear 0s infinite normal none running badge=
-spin; }

@keyframes base44-fade-in {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes base44-scale-in {=20
  0% { opacity: 0; transform: scale(0.95); }
  100% { opacity: 1; transform: scale(1); }
}
